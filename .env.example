# Copy this file to .env and fill in your own values.
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Optional. When set, the admin dashboard asks for this token and the
# /admin endpoints refuse requests without it.
ADMIN_TOKEN=

# Set to 1 while developing for auto-reload and the debugger.
FLASK_DEBUG=0
